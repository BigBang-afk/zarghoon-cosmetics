# Copy this file to ".env" and fill in the values. Never commit ".env".

# ── Database ── PostgreSQL connection string (local, Neon or Supabase)
DATABASE_URL=

# ── Admin login (Auth.js) ──
# A long random secret. Create one with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Your site's public address, e.g. http://localhost:3000 locally or https://zarghoon.com live
AUTH_URL=
# Set to "true" when deploying behind Vercel (Vercel sets this up automatically)
AUTH_TRUST_HOST=

# ── First owner account (used only by "npm run db:seed") ──
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# ── CJdropshipping (Stage 4) ──
CJ_API_KEY=

# ── Payments (Stage 3) ──
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=

# ── Email (Stage 6) ──
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_ALERT_EMAIL=

# ── Background jobs (Stage 5) ── secret that the cron caller must send
CRON_SECRET=
